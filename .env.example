# Copy this file to .env and fill in your real Postgres connection string.
# .env is in .gitignore — it will never be pushed to GitHub.
#
# Get this value from Render: your Postgres instance's dashboard page has
# an "Internal Database URL" (use that if the CRM will also run as a
# Render service) and an "External Database URL" (use that to connect from
# your Mac). It looks like:
#   postgres://someuser:somepassword@somehost/somedbname
DATABASE_URL=postgres://user:password@host:5432/dbname
